pipeline {
    agent any
    tools {nodejs "NodeJS"}
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Jenkins pipeline is working!'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

    }
}