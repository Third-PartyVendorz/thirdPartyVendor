pipeline {
	agent any

	environment {
		AWS_REGION = 'us-east-2'
		ECR_REPOSITORY_SPRING = 'spring-ecr-repository'
		ECR_REPOSITORY_FLASK = 'flask-ecr-repository'
		IMAGE_TAG = "${env.BUILD_NUMBER}"
	}

	stages {
		stage('Package Lambda') {
			steps {
				sh 'bash mock-deploy/testing/build-lambda.sh'
			}
		}

		stage('Provision ECR') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					dir('mock-deploy/tf') {
						sh '''
							terraform init
							terraform apply -auto-approve -target=aws_ecr_repository.spring_repository -target=aws_ecr_repository.flask_repository
						'''
					}
				}
			}
		}

		stage('Build image') {
			steps {
				// sh 'docker build -t ${ECR_REPOSITORY}:${IMAGE_TAG} mock-deploy/mock-api'
				sh 'docker build -t ${ECR_REPOSITORY_SPRING}:${IMAGE_TAG} api/'
				sh 'docker build -t ${ECR_REPOSITORY_FLASK}:${IMAGE_TAG} analytics/'
			}
		}

		stage('Push image') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					sh '''
						ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
						REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
						aws ecr get-login-password --region "${AWS_REGION}" | docker login --username AWS --password-stdin "${REGISTRY}"
						docker tag "${ECR_REPOSITORY_SPRING}:${IMAGE_TAG}" "${REGISTRY}/${ECR_REPOSITORY_SPRING}:${IMAGE_TAG}"
						docker push "${REGISTRY}/${ECR_REPOSITORY_SPRING}:${IMAGE_TAG}"
						docker tag "${ECR_REPOSITORY_FLASK}:${IMAGE_TAG}" "${REGISTRY}/${ECR_REPOSITORY_FLASK}:${IMAGE_TAG}"
						docker push "${REGISTRY}/${ECR_REPOSITORY_FLASK}:${IMAGE_TAG}"
					'''
				}
			}
		}

		stage('Deploy infrastructure') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					dir('mock-deploy/tf') {
						sh '''
							terraform init
							terraform apply -auto-approve -var="spring_image=${IMAGE_TAG}" -var="flask_image=${IMAGE_TAG}"
						'''
					}
				}
			}
		}

		stage('Verify RDS connection') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					dir('mock-deploy/tf') {
						sh '''
							set -eu
							FUNCTION_NAME=$(terraform output -raw rds_connector_function_name)
							RESULT_DIR=$(mktemp -d)
							trap 'rm -rf -- "$RESULT_DIR"' EXIT

							aws lambda wait function-active-v2 --function-name "$FUNCTION_NAME" --region "$AWS_REGION"
							aws lambda wait function-updated-v2 --function-name "$FUNCTION_NAME" --region "$AWS_REGION"
							aws lambda invoke \
								--function-name "$FUNCTION_NAME" \
								--region "$AWS_REGION" \
								--invocation-type RequestResponse \
								--cli-binary-format raw-in-base64-out \
								--payload '{}' \
								--output json \
								"$RESULT_DIR/response.json" > "$RESULT_DIR/metadata.json"

							# Lambda handler failures can still produce an AWS CLI exit code of zero.
							python3 - "$RESULT_DIR/metadata.json" "$RESULT_DIR/response.json" <<'PY'
import json
import sys

with open(sys.argv[1]) as stream:
    metadata = json.load(stream)
with open(sys.argv[2]) as stream:
    response = json.load(stream)

if metadata.get("StatusCode") != 200 or metadata.get("FunctionError"):
    sys.exit("RDS connectivity Lambda failed: " + json.dumps(response))
if not isinstance(response, dict) or response.get("statusCode") != 200 or not response.get("version"):
    sys.exit("RDS connectivity check returned an unexpected response: " + json.dumps(response))

print("SUCCESS: Lambda connected to RDS and executed SELECT version();")
print("PostgreSQL version:", response["version"])
PY
						'''
					}
				}
			}
		}

		stage('Verify API') {
			steps {
				sleep time: 3, unit: 'MINUTES'
				dir('mock-deploy/tf') {
					sh '''
						ALB_HOST=$(terraform output -raw alb_hostname)
						API_URL="http://${ALB_HOST}:8081/"
						echo "API URL: ${API_URL}"
						curl --fail --show-error --silent --retry 1 --retry-connrefused --retry-delay 10 --connect-timeout 10 --max-time 30 "${API_URL}"
						echo
					'''
				}
			}
		}
	}

	post {
		always {
			withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
				dir('mock-deploy/tf') {
					sh '''
						terraform init
						terraform destroy -auto-approve -var="spring_image=${IMAGE_TAG}" -var="flask_image=${IMAGE_TAG}"
					'''
				}
			}
		}
	}
}
