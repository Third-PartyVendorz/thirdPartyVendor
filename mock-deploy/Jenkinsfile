pipeline {
	agent any

	environment {
		AWS_REGION = 'us-east-2'
		ECR_REPOSITORY = 'spring-ecr-repository'
		IMAGE_TAG = "${env.BUILD_NUMBER}"
	}

	stages {
		stage('Provision ECR') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					dir('mock-deploy/tf') {
						sh '''
							terraform init
							terraform apply -auto-approve -target=aws_ecr_repository.spring_repository
						'''
					}
				}
			}
		}

		stage('Build image') {
			steps {
				sh 'docker build -t ${ECR_REPOSITORY}:${IMAGE_TAG} mock-deploy/mock-api'
			}
		}

		stage('Push image') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					sh '''
						ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
						REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
						aws ecr get-login-password --region "${AWS_REGION}" | docker login --username AWS --password-stdin "${REGISTRY}"
						docker tag "${ECR_REPOSITORY}:${IMAGE_TAG}" "${REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
						docker push "${REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
					'''
				}
			}
		}

		stage('Deploy infrastructure') {
			steps {
				withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
					dir('mock-deploy/tf') {
						sh '''
							terraform init
							terraform apply -auto-approve -var="spring_image=${IMAGE_TAG}"
						'''
					}
				}
			}
		}

		stage('Test RDS connection') {
			steps {
				withCredentials([usernamePassword(credentialsId: 'rds-credentials', usernameVariable: 'RDSUSER', passwordVariable: 'PGPASSWORD')]) {
					dir('mock-deploy/tf') {
						sh '''
							export RDSHOST="$(terraform output -raw rds_hostname)"
							export PGCONNECT_TIMEOUT=10
							curl --fail --show-error --silent --location \
								--connect-timeout 10 --max-time 60 \
								https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
								-o global-bundle.pem
							docker run --rm --network host \
								--env PGPASSWORD --env PGCONNECT_TIMEOUT \
								--mount "type=bind,source=$PWD/global-bundle.pem,target=/certs/global-bundle.pem,readonly" \
								postgres:17 \
								psql "host=$RDSHOST port=5432 dbname=tpv_primary user=$RDSUSER sslmode=verify-full sslrootcert=/certs/global-bundle.pem" \
								--no-password --no-psqlrc --set=ON_ERROR_STOP=1 \
								--command='SELECT current_database(), current_user;'
						'''
					}
				}
			}
		}

		stage('Verify API') {
			steps {
				sleep time: 5, unit: 'MINUTES'
				dir('mock-deploy/tf') {
					sh '''
						ALB_HOST=$(terraform output -raw alb_hostname)
						API_URL="http://${ALB_HOST}:8080/"
						echo "API URL: ${API_URL}"
						curl --fail --show-error --silent --retry 10 --retry-connrefused --retry-delay 10 --connect-timeout 10 --max-time 30 "${API_URL}"
						echo
					'''
				}
			}
		}
	}

	post {
		always {
			withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
				dir('mock-deploy/tf') {
					sh '''
						terraform init
						terraform destroy -auto-approve -var="spring_image=${IMAGE_TAG}"
					'''
				}
			}
		}
	}
}
